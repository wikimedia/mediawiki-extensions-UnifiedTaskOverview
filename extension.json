{
	"name": "UnifiedTaskOverview",
	"version": "3.2.0-alpha.1",
	"license-name": "GPL-3.0-only",
	"author": [
		"[https://www.hallowelt.com Hallo Welt! GmbH]"
	],
	"url": "https://en.wiki.bluespice.com/wiki/Reference:UnifiedTaskOverview",
	"descriptionmsg": "unifiedtaskoverview-desc",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"extensions": {
			"OOJSPlus": ">= 3.0.0"
		}
	},
	"attributes": {
		"UnifiedTaskOverview": {
			"AttentionIndicatorCollectionRegistry": [],
			"TaskDescriptorRegistry": []
		},
		"BlueSpiceDiscovery": {
			"AttentionIndicatorRegistry": {
				"taskoverview": "\\MediaWiki\\Extension\\UnifiedTaskOverview\\AttentionIndicator\\TaskOverview::factory"
			}
		},
		"ContentDroplets": {
			"Droplets": {
				"mytasks": {
					"class": "\\MediaWiki\\Extension\\UnifiedTaskOverview\\ContentDroplets\\MyTasksDroplet"
				}
			}
		}
	},
	"callback": "mwsInitComponents",
	"MessagesDirs": {
		"UnifiedTaskOverview": "i18n"
	},
	"ExtensionMessagesFiles": {
		"UnifiedTaskOverviewAlias": "languages/UnifiedTaskOverview.i18n.alias.php"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\UnifiedTaskOverview\\": "src/"
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"SpecialPages": {
		"UnifiedTaskOverview": "MediaWiki\\Extension\\UnifiedTaskOverview\\Special\\UnifiedTaskOverview"
	},
	"ResourceModules": {
		"ext.unifiedTaskOverview.specialPage": {
			"packageFiles": [
				"specialPage/init.js",
				"specialPage/TileWidget.js",
				"specialPage/TileListWidget.js"
			],
			"styles": [
				"specialPage/specialPage.less"
			],
			"messages": [
				"unifiedtaskoverview-label-no-task",
				"unifiedtaskoverview-search-placeholder",
				"unifiedtaskoverview-filter-all",
				"unifiedtaskoverview-filter-wikis-section-label"
			],
			"dependencies": [
				"ext.oOJSPlus.widgets"
			]
		},
		"ext.unifiedTaskOverview.tag.mytasks": {
			"scripts": [
				"tag/MyTasksGrid.js",
				"tag/init.js"
			],
			"messages": [
				"unifiedtaskoverview-mytasks-empty",
				"unifiedtaskoverview-mytasks-anon",
				"unifiedtaskoverview-mytasks-error",
				"unifiedtaskoverview-mytasks-column-type",
				"unifiedtaskoverview-mytasks-column-page",
				"unifiedtaskoverview-mytasks-column-namespace",
				"unifiedtaskoverview-mytasks-column-description",
				"unifiedtaskoverview-mytasks-column-instance",
				"unifiedtaskoverview-mytasks-type-workflows",
				"unifiedtaskoverview-mytasks-type-tasks",
				"unifiedtaskoverview-mytasks-type-readconfirmation"
			],
			"dependencies": [
				"ext.oOJSPlus.data",
				"oojs-ui"
			]
		},
		"ext.unifiedTaskOverview.tag.mytasks.styles": {
			"styles": [
				"tag/mytasks.less"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "UnifiedTaskOverview/resources"
	},
	"HookHandlers": {
		"setup": {
			"class": "\\MediaWiki\\Extension\\UnifiedTaskOverview\\HookHandler\\SkinTemplateNavigation\\Setup"
		},
		"runDatabaseUpdates": {
			"class": "MediaWiki\\Extension\\UnifiedTaskOverview\\HookHandler\\LoadExtensionSchemaUpdates\\RunDatabaseUpdates"
		},
		"registerTags": {
			"class": "\\MediaWiki\\Extension\\UnifiedTaskOverview\\HookHandler\\RegisterTags"
		}
	},
	"Hooks": {
		"SkinTemplateNavigation::Universal": "setup",
		"LoadExtensionSchemaUpdates": "runDatabaseUpdates",
		"MWStakeGenericTagHandlerInitTags": "registerTags"
	},
	"RestRoutes": [
		{
			"path": "/unifiedtaskoverview/list",
			"method": "GET",
			"class": "MediaWiki\\Extension\\UnifiedTaskOverview\\Rest\\ListHandler",
			"services": [ "UserFactory", "ConnectionProvider" ]
		}
	],
	"manifest_version": 2
}
